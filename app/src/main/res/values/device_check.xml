<?xml version="1.0" encoding="utf-8"?>
<resources>
    <dimen name="device_check_padding">20dp</dimen>
    <dimen name="device_check_touch">48dp</dimen>
    <style name="DeviceCheckBody">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">?android:attr/textColorPrimary</item>
    </style>
    <style name="DeviceCheckHeading" parent="DeviceCheckBody">
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:layout_marginBottom">8dp</item>
    </style>
    <style name="DeviceCheckSection" parent="DeviceCheckBody">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:layout_marginTop">24dp</item>
        <item name="android:layout_marginBottom">8dp</item>
    </style>
    <style name="DeviceCheckResult" parent="DeviceCheckBody">
        <item name="android:textSize">24sp</item>
        <item name="android:paddingVertical">12dp</item>
    </style>
    <string name="device_check_title">SignBridge · Thiết bị</string>
    <string name="device_check_description">Màn kiểm tra tích hợp TV2: dữ liệu local, camera, mic và giọng đọc. Giao diện hội thoại chia đôi sẽ do TV1 nối tiếp.</string>
    <string name="context_label">Ngữ cảnh</string>
    <string name="device_loading">Đang mở dữ liệu trên thiết bị…</string>
    <string name="retry_data">Mở lại dữ liệu</string>
    <string name="chips_title">Thẻ từ khóa</string>
    <string name="chips_help">Chọn 1–3 thẻ theo thứ tự muốn nói. Thẻ cá nhân có thể thêm hoặc xóa; dữ liệu được lưu trên máy.</string>
    <string name="new_chip_hint">Thẻ cá nhân mới (tối đa 50 ký tự)</string>
    <string name="add_chip">Lưu thẻ cá nhân</string>
    <string name="delete_chip">Xóa thẻ cá nhân đang chọn</string>
    <string name="send_chips">Gửi các thẻ đã chọn</string>
    <string name="devices_title">Camera và micro</string>
    <string name="media_privacy">Chỉ khi bạn ghi và gửi, ảnh hoặc audio mới được chuyển đến server đã cấu hình. Ảnh giữ trong bộ nhớ; audio tạm được xóa sau xử lý. Ra nền sẽ hủy thu.</string>
    <string name="open_camera">Mở camera trước</string>
    <string name="hold_sign">Giữ để ghi ký hiệu</string>
    <string name="hold_mic">Giữ micro để trả lời</string>
    <string name="stop_sign">Dừng và gửi ký hiệu</string>
    <string name="stop_mic">Dừng và gửi lời nói</string>
    <string name="sign_accessibility">Giữ để ghi ký hiệu. Với trình đọc màn hình hoặc bàn phím: kích hoạt một lần để bắt đầu, kích hoạt lại để dừng.</string>
    <string name="mic_accessibility">Giữ để ghi lời nhân viên. Với trình đọc màn hình hoặc bàn phím: kích hoạt một lần để bắt đầu, kích hoạt lại để dừng.</string>
    <string name="check_health">Kiểm tra kết nối server</string>
    <string name="outgoing_title">Câu gửi nhân viên</string>
    <string name="outgoing_empty">Chọn thẻ hoặc ghi ký hiệu để tạo câu.</string>
    <string name="replay">Đọc lại câu bằng tiếng Việt</string>
    <string name="incoming_title">Phản hồi của nhân viên</string>
    <string name="incoming_empty">Giữ micro để thu lời nhân viên và nhận tóm tắt.</string>
    <string name="history_title">Lịch sử gần đây</string>
    <string name="history_empty">Chưa có lượt hội thoại. Sau khi gửi, nội dung sẽ được lưu tại đây.</string>
    <string name="permission_camera_denied">Chưa có quyền camera. Bạn vẫn dùng được thẻ; cấp quyền trong Cài đặt ứng dụng nếu đã từ chối vĩnh viễn.</string>
    <string name="permission_mic_denied">Chưa có quyền micro. Cấp quyền trong Cài đặt ứng dụng nếu đã từ chối vĩnh viễn.</string>
    <string name="permission_mic_granted">Đã cấp quyền. Giữ micro lần nữa để bắt đầu thu.</string>
    <string name="camera_ready">Camera sẵn sàng. Giữ nút ký hiệu ít nhất 1,5 giây.</string>
    <string name="sign_details">Ký hiệu: %1$s\nĐộ tin cậy: %2$d%%. %3$s</string>
    <string name="confirm_sign">Chọn gợi ý để lưu thành thẻ, rồi chọn thẻ và gửi xác nhận.</string>
    <string name="sign_confirmed">Đã tạo câu.</string>
    <string name="transcript_format">Lời đầy đủ: %1$s</string>
    <string name="offline_format">Offline · %1$s</string>
</resources>
